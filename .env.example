# Mini Debug Assist - Environment Variables
#
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control!

# ===== AWS Configuration =====
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# CDK deployment (leave empty to use default account/region from AWS CLI)
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=us-east-1

# ===== GitHub Configuration =====
# Personal access token with 'repo' scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target repository for PRs (your fork!)
GITHUB_REPO=your-username/mini-debug-assist

# ===== Bedrock Model Configuration (Optional Overrides) =====
# MODEL_CLASSIFY=us.anthropic.claude-sonnet-5-5
# MODEL_SUBAGENT=us.anthropic.claude-sonnet-5-5
# MODEL_FIX=us.anthropic.claude-opus-5-5
# MODEL_VALIDATE=us.anthropic.claude-sonnet-5-5
# MODEL_CREATE_DIFF=us.anthropic.claude-sonnet-5-5
# MODEL_ESCALATE=us.anthropic.claude-opus-5-5

# ===== Agent Configuration =====
# Agent mode: mock or aws
# AGENT_MODE=aws

# Agent type identifier
# AGENT_TYPE=python-web

# ===== MCP Configuration =====
# Enable mock mode for MCP servers (true = in-process mocks, false = real stdio servers)
MCP_MOCK_MODE=false

# ===== DynamoDB Deduplication =====
# DEDUP_TABLE_NAME=mini-debug-assist-dedup

# ===== LangSmith Observability (Optional) =====
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=mini-debug-assist

# ===== Demo App Configuration =====
# Feature flag for discount v2 (set to 'on' to trigger division by zero bug)
DISCOUNT_V2=off

# Use AWS services in demo app (CloudWatch, X-Ray)
# DEMO_USE_AWS=true
